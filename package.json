{
  "name": "agent-office",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pixel-art office dashboard for OpenCode agents",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shreyashp47/Agent-Office.git"
  },
  "bugs": {
    "url": "https://github.com/shreyashp47/Agent-Office/issues"
  },
  "homepage": "https://github.com/shreyashp47/Agent-Office",
  "keywords": [
    "opencode",
    "dashboard",
    "pixel-art",
    "office",
    "agents",
    "visualization"
  ],
  "bin": {
    "opencode-office": "scripts/opencode-office.mjs"
  },
  "workspaces": [
    "backend",
    "frontend",
    "plugin",
    "assets"
  ],
  "scripts": {
    "build": "npm run build -w backend -w plugin -w frontend",
    "test": "npm run test -w backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w backend -w plugin && tsc --noEmit -p scripts/tsconfig.json",
    "start": "npm run start -w backend",
    "office": "node scripts/opencode-office.mjs",
    "dev": "npm run dev -w backend",
    "smoke": "tsx scripts/smoke_test.ts",
    "tunnel": "bash scripts/tunnel.sh",
    "install-plugin": "npm run install-plugin -w plugin"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^17.11.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}